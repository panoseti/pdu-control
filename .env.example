# Copy to .env and fill in real values:  cp .env.example .env
# Load into the current shell before running pdu.py:
#   set -a; source .env; set +a

# UniFi OS console address (e.g. UCG-Fiber LAN IP). Append :port if not 443.
UNIFI_HOST=192.168.1.1

# Local UniFi OS account (not a Ubiquiti cloud/SSO account).
# View Only is enough for `list`; on/off/cycle need Network management permission.
UNIFI_USER=pdu-admin
UNIFI_PASS=change-me

# UniFi Network site name (optional).
UNIFI_SITE=default
